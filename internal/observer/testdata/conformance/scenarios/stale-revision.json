{
  "name": "stale revision is refused without a write",
  "steps": [
    {
      "operation": "register",
      "request": {
        "identity": { "observer": "mead", "domain": "wren" },
        "revision": 0,
        "request_id": "register"
      },
      "payload": "../../wren/question.json",
      "expect": {
        "status": "ok",
        "revision": 1,
        "entry": {
          "id": "wren/mead/days-repeating",
          "state": "observing",
          "observations": [],
          "in_flight": []
        }
      }
    },
    {
      "operation": "activate",
      "request": {
        "identity": { "observer": "mead", "domain": "wren" },
        "revision": 1,
        "request_id": "activate"
      },
      "payload": "../../wren/experiment.json",
      "expect": {
        "status": "ok",
        "revision": 2,
        "entry": {
          "id": "wren/mead/days-repeating",
          "state": "observing",
          "experiment_status": "live",
          "observations": [],
          "in_flight": []
        }
      }
    },
    {
      "operation": "record",
      "request": {
        "identity": { "observer": "mead", "domain": "wren" },
        "revision": 2,
        "request_id": "record"
      },
      "payload": "../../wren/assessment.json",
      "expect": {
        "status": "ok",
        "revision": 3,
        "entry": {
          "id": "wren/mead/days-repeating",
          "state": "answered",
          "experiment_status": "live",
          "observations": [
            {
              "at": "2026-09-17T07:00:00-07:00",
              "outcome": "effect-observed"
            }
          ],
          "in_flight": []
        }
      }
    },
    {
      "operation": "claim",
      "request": {
        "identity": { "observer": "mead", "domain": "wren" },
        "revision": 2,
        "request_id": "stale-claim"
      },
      "payload": "../../wren/action.json",
      "expect": {
        "status": "refused",
        "revision": 3,
        "refusal": "stale-revision"
      }
    },
    {
      "operation": "entry",
      "entry_id": "wren/mead/days-repeating",
      "expect": {
        "status": "ok",
        "revision": 3,
        "entry": {
          "id": "wren/mead/days-repeating",
          "state": "answered",
          "experiment_status": "live",
          "observations": [
            {
              "at": "2026-09-17T07:00:00-07:00",
              "outcome": "effect-observed"
            }
          ],
          "in_flight": []
        }
      }
    }
  ]
}
