        "revision": 0,
        "request_id": "register"
      },
      "payload": "../../wren/question.json",
      "expect": {
        "status": "ok",
        "revision": 1,
        "entry": {
          "id": "wren/mead/days-repeating",
          "state": "observing",
          "observations": [],
          "in_flight": []
        }
      }
    },
    {
      "operation": "activate",
      "request": {
        "identity": { "observer": "mead", "domain": "wren" },
        "revision": 1,
        "request_id": "activate"
      },
      "payload": "../../wren/experiment.json",
      "expect": {
